# Copy to `.env` and fill in. Used by client_example.py and the TS client.
# (The Modal app reads its own values from Modal Secrets, not this file.)

# Public URL of the deployed ASGI web app. `modal deploy modal/app.py` prints it.
MODAL_EMBED_MODAL_URL=https://<workspace>--modal-embedding-server.modal.run

# Must match the API_TOKEN stored in the `embedding-auth` Modal secret.
MODAL_EMBED_API_TOKEN=replace-with-the-token-you-generated
